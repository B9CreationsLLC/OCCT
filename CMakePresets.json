{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "BUILD_USE_VCPKG": "OFF",
        "BUILD_LIBRARY_TYPE": "Shared",
        "BUILD_MODULE_FoundationClasses": "OFF",
        "BUILD_MODULE_ModelingData": "OFF",
        "BUILD_MODULE_ModelingAlgorithms": "OFF",
        "BUILD_MODULE_Visualization": "OFF",
        "BUILD_MODULE_ApplicationFramework": "OFF",
        "BUILD_MODULE_DataExchange": "OFF",
        "BUILD_MODULE_Draw": "OFF",
        "BUILD_ADDITIONAL_TOOLKITS": "TKDESTEP;TKDESTL;TKShHealing;TKMesh",
        "BUILD_DOC_Overview": "OFF",
        "BUILD_GTEST": "OFF",
        "USE_FREETYPE": "OFF",
        "USE_OPENGL": "OFF",
        "USE_TCL": "OFF",
        "USE_TK": "OFF"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" }
  ]
}
